<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --navy:     #0C1E35;
  --navy-mid: #142B4A;
  --navy-lt:  #1E3A5F;
  --orange:   #FF5900;
  --orange-lt:#FFF0E8;
  --white:    #FFFFFF;
  --offwhite: #F7F5F2;
  --rule:     #E8E4DE;
  --fg:       #111827;
  --fg-mid:   #374151;
  --fg-dim:   #9CA3AF;
}

body {
  font-family: 'DM Sans', system-ui, sans-serif;
  font-size: 9.5pt;
  line-height: 1.6;
  color: var(--fg);
  background: var(--white);
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

@page { size: A4; margin: 0; }

.page {
  width: 210mm;
  min-height: 297mm;
  position: relative;
  overflow: hidden;
  page-break-after: always;
}
.page:last-child { page-break-after: avoid; }

/* ── COVER ── */
.cover {
  background: var(--navy);
  display: flex;
  flex-direction: column;
  min-height: 297mm;
}
.cover-stripe { background: var(--orange); height: 5mm; }
.cover-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 16mm;
}
.cover-top { flex: 1; display: flex; align-items: flex-end; padding-bottom: 12mm; }
.cover-eyebrow {
  font-size: 7pt;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
}
.cover-mid { padding-bottom: 14mm; }
.cover-name {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 44pt;
  color: var(--white);
  line-height: 1.0;
  letter-spacing: -0.02em;
  margin-bottom: 4mm;
}
.cover-role {
  font-size: 10.5pt;
  font-weight: 300;
  color: var(--orange);
  letter-spacing: 0.04em;
  margin-bottom: 10mm;
}
.cover-statement {
  font-size: 9pt;
  font-weight: 300;
  color: rgba(255,255,255,0.55);
  line-height: 1.85;
  max-width: 130mm;
  margin-bottom: 14mm;
