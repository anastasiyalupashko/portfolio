.cover-statement strong { color: rgba(255,255,255,0.85); font-weight: 500; }
.cover-divider { height: 1px; background: rgba(255,255,255,0.1); margin-bottom: 10mm; }
.cover-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding-bottom: 14mm;
}
.stat-num {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 22pt;
  color: var(--orange);
  display: block;
  line-height: 1;
  margin-bottom: 2mm;
}
.stat-label {
  font-size: 6.5pt;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
  line-height: 1.4;
}
.cover-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 10mm;
}
.cover-contact { display: flex; gap: 8mm; }
.cover-contact span { font-size: 7pt; color: rgba(255,255,255,0.3); }
.cover-year { font-size: 7pt; color: rgba(255,255,255,0.15); }
.cover-bottom-stripe { background: var(--orange); height: 2px; }

/* ── INNER PAGES ── */
.inner { background: var(--white); }

.ph {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7mm 16mm 5mm;
