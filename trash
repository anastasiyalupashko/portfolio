  color: var(--fg);
}
.case-minis { display: flex; flex-direction: column; gap: 4mm; }
.mini-num {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: 13pt;
  color: var(--navy);
  display: block;
  line-height: 1;
  margin-bottom: 1mm;
